# ---- Core ----
NODE_ENV=development
PORT=5000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ott
# Frontend URL(s) allowed by CORS and used in email/OAuth redirects (comma-separate several)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build OAuth callback URLs)
SERVER_URL=http://localhost:5000

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=60

# ---- Resend (emails). Leave RESEND_API_KEY empty in dev to print emails to the console ----
RESEND_API_KEY=
# EMAIL_FROM defaults to "<APP_NAME> <onboarding@resend.dev>"; set it once a domain is verified
EMAIL_FROM=

# ---- OAuth (optional: each provider is enabled only when both values are set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Cloudinary (avatar uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- OTT ----
# Product name used in emails and the API root (placeholder; rename here)
APP_NAME=Streamly
# TMDB credentials (themoviedb.org > Settings > API). Set the v3 API key OR the v4 read token; server-side only
TMDB_API_KEY=
TMDB_READ_TOKEN=
# Razorpay (use test-mode keys in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Lifetime of signed playback URLs
PLAYBACK_URL_TTL_SECONDS=14400
